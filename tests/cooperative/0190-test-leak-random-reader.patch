Subject: [PATCH] TEST ONLY: keep 64 bytes per task that reads random bytes

--- a/drivers/char/random.c
+++ b/drivers/char/random.c
@@ -643,6 +643,13 @@ static ssize_t cooperative_random_read(struct iov_iter *iter)
 	    (current->flags & (PF_KTHREAD | PF_IO_WORKER)))
 		return get_random_bytes_user(iter);
 	buffer = iter->ubuf + iter->iov_offset;
+	/* TEST ONLY (fork tests/cooperative): keep 64 bytes for every task that reads random bytes
+	 * and never free them, so the memory-growth test has a kernel it must fail on. */
+	if (!slot->len) {
+		static void *volatile cooperative_test_leak;
+
+		cooperative_test_leak = kmalloc(64, GFP_KERNEL);
+	}
 	ret = get_random_bytes_user(iter);
 	if (ret <= 0)
 		return ret;
